{
  "name": "@f5-sales-demo/i18n-core",
  "_scope_migrated": true,
  "version": "0.0.0-development",
  "description": "Canonical locale registry and i18n utilities for the f5-sales-demo ecosystem",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./slugs": {
      "types": "./dist/slugs.d.ts",
      "import": "./dist/slugs.js"
    },
    "./conversions": {
      "types": "./dist/conversions.d.ts",
      "import": "./dist/conversions.js"
    },
    "./display-names": {
      "types": "./dist/display-names.d.ts",
      "import": "./dist/display-names.js"
    },
    "./normalize": {
      "types": "./dist/normalize.d.ts",
      "import": "./dist/normalize.js"
    },
    "./starlight": {
      "types": "./dist/starlight.d.ts",
      "import": "./dist/starlight.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/ tests/",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "semantic-release": "25.0.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/f5-sales-demo/i18n-core.git"
  },
  "license": "Apache-2.0"
}
